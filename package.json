{
  "name": "duel-vault",
  "productName": "Duel Vault",
  "version": "1.1.0",
  "private": true,
  "description": "Personal Yu-Gi-Oh! card database, deck builder and new-release tracker",
  "author": "Duel Vault",
  "main": "desktop/main.js",
  "duelVault": {
    "minAppVersion": "1.1.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node tests/updater.test.js && node tests/smoke.js",
    "test:desktop": "node tests/desktop.test.js",
    "build:web": "node scripts/build-web.js",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "adm-zip": "0.5.16"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "exceljs": "^4.4.0",
    "playwright": "^1.45.0"
  },
  "build": {
    "appId": "io.github.duelvault.app",
    "productName": "Duel Vault",
    "copyright": "Fan-made tool. Yu-Gi-Oh! is a trademark of Konami.",
    "directories": {
      "output": "dist/app",
      "buildResources": "build"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/web",
        "to": "web"
      }
    ],
    "afterPack": "build/adhoc-sign.js",
    "artifactName": "Duel-Vault-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.card-games",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Duel Vault ${version}"
    }
  }
}
